{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omid-os",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "NODE_ENV": "production",
    "OLLAMA_BASE_URL": "https://ollama.com/api",
    "OLLAMA_MODEL": "llama3.2"
  }
}
